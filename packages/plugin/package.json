{
  "name": "@sd-tailscale/plugin",
  "version": "0.0.0",
  "description": "Stream Deck plugin for Tailscale",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "link": "streamdeck link dev.yrh.tailscale.sdPlugin",
    "render:icons": "node scripts/render-icons.mjs",
    "validate": "streamdeck validate dev.yrh.tailscale.sdPlugin",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sd-tailscale/core": "workspace:*"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
